# Copy to .env for Docker Compose. Never commit real credentials.
APP_PORT=8080
FRONTEND_ORIGIN=http://localhost:8080

# First-run password setup is completed inside the app.
# Keep the API database on persistent storage.
AUTH_DB_PATH=/data/trade_desk.sqlite3

# Optional provider credentials
TWELVE_DATA_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional Telegram alerts for monitoring events
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MONITORING_MAX_SNAPSHOT_AGE_SECONDS=300

# Maximum age allowed for the latest candle used in thesis reassessment
THESIS_MAX_CANDLE_AGE_SECONDS=7200

# Optional override for persistent session history storage
SESSION_DB_PATH=/data/market_sessions.sqlite3
