# Copy to .env for Docker Compose. Never commit real credentials.
APP_PORT=8080
FRONTEND_ORIGIN=http://localhost:8080

# Optional provider credentials
TWELVE_DATA_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Telegram alerts for monitoring events
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MONITORING_MAX_SNAPSHOT_AGE_SECONDS=300
\n# Maximum age allowed for the latest candle used in thesis reassessment\nTHESIS_MAX_CANDLE_AGE_SECONDS=7200\n