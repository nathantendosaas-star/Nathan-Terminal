# Optional deployment configuration
# FRONTEND_ORIGIN=http://localhost:5173

# Required only when using provider=twelvedata for stocks, forex, ETFs, etc.
# Get a key from https://twelvedata.com/
TWELVE_DATA_API_KEY=

# Optional Telegram delivery for stop-loss / take-profit monitoring alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MONITORING_MAX_SNAPSHOT_AGE_SECONDS=300
