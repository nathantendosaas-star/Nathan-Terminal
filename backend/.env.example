# Supabase PostgreSQL (required in production; leave unset for local SQLite tests)
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@[pooler-host]:5432/postgres?sslmode=require

# Optional deployment configuration
# FRONTEND_ORIGIN=http://localhost:5173

# Required only when using provider=twelvedata for stocks, forex, ETFs, etc.
# Get a key from https://twelvedata.com/
TWELVE_DATA_API_KEY=

MONITORING_MAX_SNAPSHOT_AGE_SECONDS=300

GEMINI_MODEL=gemini-3.8-flash
